# VITE_API_URL: base URL for the backend API. Leave unset in dev — vite.config.ts
# proxies /api to http://localhost:8000. Set to the deployed API origin in prod.
# VITE_API_URL=https://api.example.com/api

# VITE_BOT_USERNAME: bot username (no @), used to build the share deep link.
# VITE_BOT_USERNAME=teplee_game_bot

# VITE_DEV_INIT_DATA: only for local browser dev outside real Telegram, where
# window.Telegram.WebApp.initData is empty and the API would 401. Generate a
# signed fixture with the same BOT_TOKEN the backend uses:
#
#   cd backend && uv run python -c "
#   import time
#   from app.auth import sign_init_data
#   print(sign_init_data({
#       'user': '{\"id\":1,\"first_name\":\"Dev\"}',
#       'auth_date': str(int(time.time())),
#   }, 'test:token'))"
#
# VITE_DEV_INIT_DATA=user=...&auth_date=...&hash=...
